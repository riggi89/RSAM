<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RSAM</RootNamespace>
    <AssemblyName>RSAM.Core</AssemblyName>
    <AssemblyTitle>RSAM.Core</AssemblyTitle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>Daniel Riggi (riggi89)</Company>
    <Authors>Daniel Riggi (riggi89); Rick (Gibbed)</Authors>
    <Description>Core models, services, search contracts and Steam schema support for RSAM.</Description>
    <Copyright>RSAM modifications Copyright © 2026 Daniel Riggi (riggi89). Original Steam Achievement Manager Copyright © 2024 Rick (Gibbed).</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RSAM.API\RSAM.API.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\Resources\*.json">
      <LogicalName>RSAM.Localization.Resources.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <None Update="Localization\Resources\*.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          TargetPath="Localization\Resources\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
